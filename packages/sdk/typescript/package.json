{
  "name": "@pramaan/sdk",
  "version": "1.0.0",
  "description": "TypeScript SDK for the Pramaan registry API — verify certificates, search verified people, receive signed webhooks.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist", "src"],
  "scripts": {
    "generate": "openapi-typescript http://localhost:8000/openapi.json -o src/schema.d.ts",
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit"
  },
  "devDependencies": {
    "openapi-typescript": "^7.4.0",
    "typescript": "^5.6.0"
  }
}
