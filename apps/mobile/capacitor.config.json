{
  "appId": "in.pramaan.app",
  "appName": "Pramaan",
  "webDir": "www",
  "server": {
    "url": "https://pramaan-rose-chi.vercel.app",
    "cleartext": false,
    "allowNavigation": [
      "pramaan-rose-chi.vercel.app"
    ],
    "errorPath": "offline.html"
  },
  "android": {
    "allowMixedContent": false,
    "webContentsDebuggingEnabled": false,
    "captureInput": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 600,
      "backgroundColor": "#FFB81C"
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#FFB81C",
      "overlaysWebView": false
    }
  }
}
