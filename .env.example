# Copy to .env and fill in. Never commit .env.

# --- LLM (agents) ---
# gemini (default) or claude
LLM_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# live = call the provider, mock = deterministic offline mode (demo-safe, no key needed)
LLM_MODE=mock
# Comma-separated fallback chains (tried in order on overload/timeouts)
LLM_MODEL_SMART=gemini-3.8-flash,gemini-3.5-flash,gemini-3.1-flash-lite
LLM_MODEL_FAST=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# --- Database ---
DATABASE_URL=postgresql+asyncpg://pramaan:pramaan@localhost:5432/pramaan

# --- App ---
PUBLIC_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
JWT_SECRET=change-me-in-real-deployments
# base64 of a 32-byte Ed25519 seed. Leave empty in dev: a key is generated into backend/data/signing.key
SIGNING_KEY_B64=

# --- Optional ---
UNSPLASH_ACCESS_KEY=
TELEGRAM_BOT_TOKEN=

# Needed for public-source evidence lookups (Wikipedia bot policy). Email or URL.
WIKIMEDIA_CONTACT=

# Webhooks to private/loopback addresses are blocked unless this is true (dev only!)
WEBHOOK_ALLOW_PRIVATE=false

# Approved AI-written plugins run inside the API process: keep false unless you want that
PLUGINS_ENABLED=false
# Outreach email (leave SMTP_HOST empty for a recorded dry run)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Pramaan <no-reply@yourdomain>
