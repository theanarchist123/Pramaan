# Copy to .env and fill in. Never commit .env.

# --- LLM (agents) ---
# gemini (default) or claude
LLM_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# live = call the provider, mock = deterministic offline mode (demo-safe, no key needed)
LLM_MODE=mock
# Comma-separated fallback chains (tried in order on overload/timeouts)
LLM_MODEL_SMART=gemini-3.8-flash,gemini-3.5-flash,gemini-3.1-flash-lite
LLM_MODEL_FAST=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# --- Database ---
DATABASE_URL=postgresql+asyncpg://pramaan:pramaan@localhost:5432/pramaan

# --- App ---
# development | production | auto. Use `development` when you run the API/web on your own machine but
# PUBLIC_BASE_URL or DATABASE_URL point at a live site: it allows localhost CORS and a http cookie.
ENVIRONMENT=auto
PUBLIC_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
JWT_SECRET=change-me-in-real-deployments
# base64 of a 32-byte Ed25519 seed (python backend/scripts/gen_secrets.py). REQUIRED whenever PUBLIC_BASE_URL is not
# localhost: the API refuses to start without it, so a lost volume can't silently mint a new key and break every
# old certificate. Empty is fine in local dev: a key is generated into backend/data/signing.key
SIGNING_KEY_B64=
# After rotating the key: public keys (base64, comma-separated) of the OLD keys, so old certificates still verify.
SIGNING_RETIRED_PUBLIC_KEYS=

# --- Optional ---
UNSPLASH_ACCESS_KEY=
TELEGRAM_BOT_TOKEN=

# Needed for public-source evidence lookups (Wikipedia bot policy). Email or URL.
WIKIMEDIA_CONTACT=

# Webhooks to private/loopback addresses are blocked unless this is true (dev only!)
WEBHOOK_ALLOW_PRIVATE=true

# Approved AI-written plugins run inside the API process: keep false unless you want that
PLUGINS_ENABLED=true
# Outreach email (leave SMTP_HOST empty for a recorded dry run)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Pramaan <no-reply@yourdomain>


# --- Safety switches (all ON by default; only relax them for local experiments) ---
# Applicants must confirm their email with a one-time code before verification (needs SMTP_* in production)
REQUIRE_EMAIL_VERIFICATION=true
# Every owner's first public listing is approved by a human, never by Prahari alone
HUMAN_APPROVAL_FIRST_LISTING=true
# Award claims are confirmed by a human reviewer
AWARD_CLAIMS_NEED_HUMAN=true
# Extra document issuers to accept, comma-separated (the built-in list covers government, universities, academies)
TRUSTED_ISSUERS_EXTRA=
# Per-IP limits on login/register/OTP/public search
IP_RATE_LIMITS=true
# Session cookie SameSite: auto = lax locally, none in production (web and API on different domains)
COOKIE_SAMESITE=auto

# --- Background work ---
# The API runs the webhook-retry / scheduled-email loop itself by default. In production run
# `python -m app.worker` as its own service and set WORKER_INLINE=false on the API.
WORKER_INLINE=true
# inline = run AI-code checks in the API (needs Docker; local dev) | worker = queue them for `python -m app.worker`
# on a host with Docker | auto = inline when PUBLIC_BASE_URL is localhost, else worker
SANDBOX_MODE=auto

# --- Redis (rate limits, short locks, live-event fan-out; never the source of truth) ---
# Empty = everything stays in-process. Set but unreachable = in-process fallback + an ALERT in the logs.
# Dev: `docker compose up -d redis` then REDIS_URL=redis://localhost:6379/0
# Staging/production: managed Redis in the same region and on the private network.
REDIS_URL=

# --- Background jobs ---
# inline = run in the API process (dev). procrastinate = a Postgres-backed queue that survives restarts; the API's
# inline worker (WORKER_INLINE=true) or `python -m app.worker` runs the jobs.
JOB_BACKEND=inline
